<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rate_app_white_24">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgRateDialog"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:src="@drawable/img_rate_dialog_defaut" />

            <TextView
                android:id="@+id/tvRatingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="@string/rate_dialog_title_initial"
                android:textColor="@color/text_headline"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvRatingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/rate_dialog_subtitle_initial"
                android:textColor="@color/text_headline"
                android:textSize="14sp" />

            <com.expeditee.plant.identifier.presenter.dialog.rate_app.ApplicationRatingBar
                android:id="@+id/ratingBar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/buttonRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_dialog_rate_app_selector"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="@string/rate_us"
                android:textColor="@color/color_background"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMaybeLate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/maybe_later"
                android:textColor="@color/text_headline"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

