<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llCustomRating"
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <LinearLayout
            android:id="@+id/starContainer"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStar1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:scaleType="fitCenter"
                android:tag="rate"
                app:srcCompat="@drawable/ic_star_rate_app" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStar2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:tag="rate"
                app:srcCompat="@drawable/ic_star_rate_app" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStar3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:tag="rate"
                app:srcCompat="@drawable/ic_star_rate_app" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStar4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:tag="rate"
                app:srcCompat="@drawable/ic_star_rate_app" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStar5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:tag="rate"
                app:srcCompat="@drawable/ic_star_rate_app" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivTheBestRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:src="@drawable/ic_the_best_rating"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/starContainer"
            app:layout_constraintEnd_toEndOf="@+id/starContainer" />

        <TextView
            android:id="@+id/tvRateBest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/the_best_rating_for_us"
            android:textColor="@color/primary"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/ivTheBestRate"
            tools:ignore="MissingConstraints" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnim"
            android:layout_width="270dp"
            android:layout_height="0dp"
            android:visibility="visible"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_rawRes="@raw/rating_animation" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

