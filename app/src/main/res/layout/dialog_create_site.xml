<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_result_dialog_card"
        android:padding="@dimen/_20dp">

        <ImageView
            android:id="@+id/ivCreateSiteIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_tree_notification_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCreateSiteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:text="@string/result_create_new_site"
            android:textColor="@color/result_text_primary"
            android:textSize="@dimen/_18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivCreateSiteIcon" />

        <EditText
            android:id="@+id/etSiteName"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_result_input"
            android:fontFamily="@font/montserrat_regular"
            android:hint="@string/result_enter_new_site"
            android:paddingHorizontal="@dimen/_14dp"
            android:textColor="@color/result_text_primary"
            android:textColorHint="@color/result_text_muted"
            android:textSize="@dimen/_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCreateSiteTitle" />

        <LinearLayout
            android:id="@+id/layoutCreateSiteActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etSiteName">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="@dimen/_8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/result_green"
                android:textSize="@dimen/_14sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="21dp"
                app:strokeColor="@color/result_green"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreate"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/result_create"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sp"
                app:backgroundTint="@color/result_button_disabled"
                app:cornerRadius="21dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
