<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="maxProgress"
            type="Integer" />

        <variable
            name="currentProgress"
            type="Integer" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlayerIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="@dimen/_16dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.3"
            app:layout_constraintWidth_percent="0.25"
            app:strokeWidth="0dp">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/playerIconSplash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_splash_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_bias="0.3"
                app:layout_constraintWidth_percent="0.3" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/planty_identifier"
            android:textColor="#69AD52"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/cardPlayerIcon"
            app:layout_constraintStart_toStartOf="@+id/cardPlayerIcon"
            app:layout_constraintTop_toBottomOf="@+id/cardPlayerIcon" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:layout_marginBottom="@dimen/_10dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/nativeAdView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvAds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12dp"
                android:fontFamily="@font/poppins"
                android:text="@string/this_action_may_contain_advertising"
                android:textColor="@color/text_headline"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

            <ProgressBar
                android:id="@+id/pbLoading"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="300dp"
                android:layout_height="4dp"
                android:layout_marginBottom="10dp"
                android:max="@{maxProgress}"
                android:progress="@{currentProgress}"
                android:progressDrawable="@drawable/progress_bar_gradient"
                android:visibility="visible" />

        </LinearLayout>

        <com.expeditee.plant.identifier.admob.NativeAdView
            android:id="@+id/nativeAdView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:adShimmer="@layout/layout_shimmer_native_medium_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
