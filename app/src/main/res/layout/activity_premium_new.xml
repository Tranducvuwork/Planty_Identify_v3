<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cstTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.media3.ui.PlayerView
                android:id="@+id/ivPremium"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="fill"
                app:show_buffering="never"
                app:surface_type="surface_view"
                app:use_controller="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_line"
                app:layout_constraintBottom_toBottomOf="@+id/ivPremium" />

            <FrameLayout
                android:id="@+id/frClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginTop="@dimen/_20dp"
                android:elevation="@dimen/_4dp"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close_iap" />
            </FrameLayout>

            <com.expeditee.plant.identifier.widget.StrokeTextView
                android:id="@+id/tvPremium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeMinTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/notosans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/get_premium"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                app:fillColor="@android:color/white"
                app:shadowColor="#8A49AF2E"
                app:shadowRadius="7dp"
                app:strokeEndColor="#FFFFFF"
                app:strokeStartColor="#3D940E"
                app:strokeWidth="3.6dp"
              app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/llFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/_16dp"
            android:orientation="vertical"
            android:paddingHorizontal="50dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scan_iap" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="@string/unlimited_plant_identification"
                    android:textColor="@color/text_headline"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_care_iap" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="@string/care_schedule_reminders"
                    android:textColor="@color/text_headline"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_24_7" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="@string/_24_7_ai_plant_support"
                    android:textColor="@color/text_headline"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cstYearlyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18dp"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_sub_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="@dimen/_16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_16dp"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvYearlyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/lb_yearly_plan"
                    android:textColor="@color/text_plan_selector"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Yearly Plan" />

                <TextView
                    android:id="@+id/tvYearlySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat_medium"
                    android:maxLines="1"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    tools:text="just $39.99 per year" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_plan_radio_selector" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18dp"
            android:layout_marginTop="@dimen/_10dp">

            <LinearLayout
                android:id="@+id/cstWeeklyPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sub_selector"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_gravity="center|bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_16dp"
                android:paddingVertical="@dimen/_16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_16dp"
                    android:layout_weight="1"
                    android:duplicateParentState="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWeeklyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="@string/lb_weekly_plan"
                        android:textColor="@color/text_plan_selector"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="3-Day Free Trial" />

                    <TextView
                        android:id="@+id/tvWeeklySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_medium"
                        android:maxLines="1"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        tools:text="then $6.99 per week" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_plan_radio_selector" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPlanOffer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_iap_best_value"
                android:visibility="visible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSubscribe"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60dp"
            android:layout_marginHorizontal="@dimen/_18dp"
            android:layout_marginTop="@dimen/_18dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_btn_continue">

            <TextView
                android:id="@+id/tvSubscribe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="32dp"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="center"
                android:text="@string/start_free_trial"
                android:textColor="@color/white"
                android:textSize="18sp"
                tools:text="Subscribe Now" />

            <View
                android:id="@+id/viewShine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_shine" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:paddingVertical="@dimen/_4dp"
                    android:text="@string/terms_of_use"
                    android:textColor="@color/gray_iap"
                    android:textSize="@dimen/_12sp" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="end"
                    android:paddingVertical="@dimen/_4dp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/gray_iap"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubscribeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:lines="4"
                android:textColor="@color/gray_iap"
                android:textSize="12sp"
                tools:text="@tools:sample/lorem/random" />
        </LinearLayout>
    </LinearLayout>
</layout>
