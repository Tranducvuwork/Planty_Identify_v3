<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_result_dialog_card"
        android:padding="@dimen/_20dp">

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/result_success_title"
            android:textColor="@color/result_text_primary"
            android:textSize="@dimen/_18sp"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/ivSuccessIcon"
            android:layout_width="@dimen/_100dp"
            android:layout_height="@dimen/_100dp"
            android:layout_marginTop="@dimen/_16dp"
            android:src="@drawable/bg_tree_notification_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSuccessTitle" />

        <TextView
            android:id="@+id/text_light_meter_guide_description_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="start"
            android:maxLines="3"
            android:text="@string/hold_your_phone_next_to_the_plant_and_point_the_front_camera_toward_the_light"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSuccessIcon" />

        <TextView
            android:id="@+id/text_light_meter_guide_description_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="start"
            android:maxLines="3"
            android:text="@string/second"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_light_meter_guide_description_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGotIt"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/_16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/result_got_it"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sp"
            app:backgroundTint="@color/result_green"
            app:cornerRadius="23dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_light_meter_guide_description_2" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
