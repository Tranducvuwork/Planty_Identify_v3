<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_diary_screen">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_green"
            app:navigationIcon="@drawable/ic_close"
            app:title="Timeline"
            app:titleTextColor="@android:color/white" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_result_dialog_card"
            android:fontFamily="@font/montserrat_regular"
            android:padding="14dp"
            android:textColor="@color/result_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCareSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/plant_info_card_shape"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="#1B5E20"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnFindCure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_32dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip_idle"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:paddingVertical="@dimen/_12dp"
            android:text="Tìm cách chữa bệnh / chăm sóc"
            android:textColor="@color/primary_green" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_32dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_more_option_green"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:paddingVertical="@dimen/_14dp"
            android:text="Thêm mốc nhật ký"
            android:textColor="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTimeline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp" />
    </LinearLayout>
</layout>
