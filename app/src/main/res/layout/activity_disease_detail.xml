<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context="com.expeditee.plant.identifier.presenter.disease_detail.DiseaseDetailActivity">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:elevation="@dimen/_30dp"
            app:layout_constraintBottom_toTopOf="@id/llBottomButtonArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_16dp">

                <LinearLayout
                    android:id="@+id/llToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_60dp"
                    android:elevation="@dimen/_40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivBackToolbar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/_16dp"
                        android:src="@drawable/arrow_left"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/diseaseNameToolbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_semibold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_20sp"
                        tools:text="Powdery Mildew" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="-60dp">

                    <ImageView
                        android:id="@+id/bigSizeImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@tools:sample/avatars" />

                    <FrameLayout
                        android:id="@+id/smallSizeImageFrame"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/circle_image_white_shape"
                        android:elevation="8dp">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/smallSizeImageView"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="@dimen/_100dp"
                            tools:src="@tools:sample/avatars" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/accuracyBadge"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/ic_accuracy_badge">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProbabilityText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="92" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="%"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>

                <com.expeditee.plant.identifier.admob.NativeAdView
                    android:id="@+id/nativeAdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_8dp"
                    android:layout_marginTop="@dimen/_20dp"
                    app:adShimmer="@layout/ads_shimmer_medium_media_2"
                    app:adView="@layout/ads_native_medium_media_2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16dp">

                    <TextView
                        android:id="@+id/diseaseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/_24sp"
                        tools:text="Powdery Mildew" />

                    <TextView
                        android:id="@+id/scientificNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:textColor="#004040"
                        android:textSize="14sp"
                        tools:text="Scientific Name: Erysiphe cichoracearum" />

                    <TextView
                        android:id="@+id/otherNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:textColor="#004040"
                        android:textSize="14sp"
                        tools:text="Also known as: White mold" />

                    <LinearLayout
                        android:id="@+id/layoutDiseaseAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#FFEBEE"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvDiseaseAlertTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/thesis_disease_alert_title"
                            android:textColor="#B71C1C"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiseaseAlertMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="#5D4037"
                            tools:text="Phát hiện bệnh đốm lá..." />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnSuggestCure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_more_option_green"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:text="@string/thesis_suggest_cure"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/diseaseTabsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutDiseaseTabs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/tabOverview"
                                style="@style/DiseaseTabChip"
                                android:text="Tổng quan" />

                            <TextView
                                android:id="@+id/tabSymptoms"
                                style="@style/DiseaseTabChip"
                                android:text="Triệu chứng" />

                            <TextView
                                android:id="@+id/tabImages"
                                style="@style/DiseaseTabChip"
                                android:text="Hình ảnh" />

                            <TextView
                                android:id="@+id/tabTreatment"
                                style="@style/DiseaseTabChip"
                                android:text="Xử lý" />

                            <TextView
                                android:id="@+id/tabVideos"
                                style="@style/DiseaseTabChip"
                                android:text="Video" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <include
                    android:id="@+id/diseaseInfo"
                    layout="@layout/disease_info_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/llBottomButtonArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/flRetakeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/add_plant_btn_shape_green"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_camera_scan_other" />

                    <TextView
                        android:id="@+id/tvRetakeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="@string/diagnose_another_plant"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/_14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#004040"
            android:textSize="@dimen/_14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
