<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/llToolbar"
            android:layout_width="0dp"
            android:layout_height="@dimen/_60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBackToolbar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/_16dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/close"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat_semibold"
                android:maxLines="1"
                android:text="@string/photo_library"
                android:textColor="#020617"
                android:textSize="@dimen/_18sp" />

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/_16dp"
                android:src="@drawable/ic_share_detail"
                android:contentDescription="@string/share"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoViewPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_4dp"
            app:layout_constraintBottom_toTopOf="@id/llPhotoBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llToolbar" />

        <LinearLayout
            android:id="@+id/llPhotoBottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="@dimen/_12dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/indexText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_8dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center"
                android:textColor="@color/text_color_main"
                android:textSize="@dimen/_14sp"
                tools:text="1 / 4" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photoListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/_4dp"
                android:orientation="horizontal"
                tools:listitem="@layout/item_photo_thumbnail" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
