<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_green"
            app:navigationIcon="@drawable/ic_close"
            app:title="Kết quả nhận diện"
            app:titleTextColor="@android:color/white" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/ivPlant"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:riv_corner_radius="16dp"
                            tools:src="@drawable/ic_camera_home" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCommonName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="#1B1B1B"
                                android:textSize="20sp"
                                tools:text="Diếp cá" />

                            <TextView
                                android:id="@+id/tvScientific"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins"
                                android:textColor="#666666"
                                android:textSize="13sp"
                                android:textStyle="italic"
                                tools:text="Houttuynia cordata" />

                            <TextView
                                android:id="@+id/tvFamily"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins"
                                android:textColor="#555555"
                                android:textSize="12sp"
                                tools:text="Họ Diếp cá (Saururaceae)" />

                            <TextView
                                android:id="@+id/tvPlantGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="#2E7D32"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Nhóm: cây thuốc"
                                tools:visibility="gone" />

                            <TextView
                                android:id="@+id/tvMedicinalBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_confidence_pill"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="Cây thuốc"
                                android:textColor="@color/primary_green"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tvConfidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_confidence_pill"
                                android:fontFamily="@font/poppins_medium"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/primary_green"
                                android:textSize="12sp"
                                tools:text="Độ tin cậy: 95%" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/layoutToxic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFEBEE"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvToxicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Cảnh báo độc"
                        android:textColor="#B71C1C"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvToxicMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#5D4037"
                        tools:text="Cảnh báo nấm độc..." />

                    <TextView
                        android:id="@+id/tvFirstAid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#3E2723"
                        tools:text="Sơ cứu: ..." />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:id="@+id/layoutAiPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivAiMascot"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvAiPrompt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins"
                                android:textColor="#333333"
                                android:textSize="14sp"
                                tools:text="Tôi đã nhận dạng đây là cây diếp cá. Bạn muốn biết thêm?" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutAiChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabInfo"
                            android:layout_width="104dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_tab_selected"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Thông tin"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabUses"
                            android:layout_width="108dp"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_tab_unselected"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Công dụng"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabCare"
                            android:layout_width="108dp"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_tab_unselected"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Chăm sóc"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabNotes"
                            android:layout_width="92dp"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_tab_unselected"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Lưu ý"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabMap"
                            android:layout_width="96dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tab_unselected"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Vị trí"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/layoutDetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tvDescriptionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Mô tả"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        tools:text="Mô tả cây..." />

                    <TextView
                        android:id="@+id/tvMorphologyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Đặc điểm hình thái"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvMorphology"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/layoutMorphologyParts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:id="@+id/ivMorphRoot"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_morph_root"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvMorphRoot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_morph_root"
                                android:textColor="#1B1B1B"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp">

                            <ImageView
                                android:id="@+id/ivMorphStem"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_morph_stem"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvMorphStem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_morph_stem"
                                android:textColor="#1B1B1B"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <ImageView
                                android:id="@+id/ivMorphLeaf"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_morph_leaf"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvMorphLeaf"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_morph_leaf"
                                android:textColor="#1B1B1B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:id="@+id/ivMorphFlower"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_morph_flower"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_morph_flower"
                                android:textColor="#1B1B1B"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <ImageView
                                android:id="@+id/ivMorphFruit"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_morph_fruit"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_morph_fruit"
                                android:textColor="#1B1B1B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOriginTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Nguồn gốc / phân bố"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUsesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Công dụng"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvUses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        tools:text="• Công dụng" />

                    <TextView
                        android:id="@+id/tvRelatedVarietiesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/thesis_related_varieties_title"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRelatedVarieties"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Cúc có các giống sau: cúc đại đóa, cúc pingpong..." />

                    <TextView
                        android:id="@+id/tvCareTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Cách trồng &amp; chăm sóc"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPlanting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWater"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFertilizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnFindFertilizerStore"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_fertilizer_store_button"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/thesis_find_fertilizer_store"
                        android:textColor="@color/primary_green"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvBuySeedLinksTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/thesis_buy_seed_links_title"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutBuySeedLinks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvFertilizerStagesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/thesis_fertilizer_stages_title"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutFertilizerStages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:id="@+id/ivFertOrganic"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_fert_organic"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_fert_organic"
                                android:textColor="#1B1B1B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp">

                            <ImageView
                                android:id="@+id/ivFertNpk"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_fert_npk"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_fert_npk"
                                android:textColor="#1B1B1B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <ImageView
                                android:id="@+id/ivFertKali"
                                android:layout_width="match_parent"
                                android:layout_height="92dp"
                                android:contentDescription="@string/thesis_fert_kali"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="@string/thesis_fert_kali"
                                android:textColor="#1B1B1B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBestSeason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHarvestTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Thu hoạch và bảo quản"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvHarvest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvCitationsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Video / tài liệu tham khảo"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layoutCitations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvCitationNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDiseasesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Sâu bệnh thường gặp"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layoutDiseases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvFolkTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Bài thuốc dân gian liên quan"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layoutFolk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvDisclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        tools:text="Disclaimer" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSaveDiary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Lưu nhật ký"
                android:textColor="@color/primary_green" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Chia sẻ"
                android:textColor="@color/primary_green" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnMap"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Bản đồ"
                android:textColor="@color/primary_green" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sửa"
                android:textColor="#B71C1C" />
        </LinearLayout>
    </LinearLayout>
</layout>
