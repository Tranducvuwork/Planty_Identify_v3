<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_round_12_white"
    android:padding="12dp">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/ivDiseaseImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_round_16_white"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="8dp"
        tools:src="@drawable/ic_diagnose_home" />

    <TextView
        android:id="@+id/tvDiseaseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivDiseaseImage"
        app:layout_constraintTop_toTopOf="@id/ivDiseaseImage"
        tools:text="Powdery Mildew" />

    <TextView
        android:id="@+id/tvDiseaseDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_body"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvDiseaseName"
        app:layout_constraintTop_toBottomOf="@id/tvDiseaseName"
        tools:text="White powdery spots on leaves and stems." />

</androidx.constraintlayout.widget.ConstraintLayout>
