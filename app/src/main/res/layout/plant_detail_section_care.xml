<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/conditions"
        android:textColor="#020617"
        android:textSize="@dimen/_16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:background="@drawable/plant_info_card_shape"
        android:orientation="vertical"
        android:padding="@dimen/_12dp">

        <TextView
            android:id="@+id/soil_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            tools:text="Soil / Size: Well-drained" />

        <TextView
            android:id="@+id/sunlight_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            tools:text="Sunlight: Full sun" />

        <TextView
            android:id="@+id/temp_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            tools:text="Temperature: 15-25 C" />

        <TextView
            android:id="@+id/humid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            tools:text="Humidity: 60-70%" />

        <TextView
            android:id="@+id/attract_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            tools:text="Propagation: Cutting" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/plant_detail_requirements"
        android:textColor="@color/text_main_color"
        android:textSize="@dimen/_16sp" />

    <LinearLayout
        android:id="@+id/requirements_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_water"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/plant_info_card_shape"
                android:gravity="center"
                android:layout_marginEnd="@dimen/_4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_watering_detail" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/watering"
                    android:textColor="@color/text_headline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/water_text_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Unknown"
                    android:gravity="center_vertical"
                    android:lines="2"
                    android:textColor="@color/text_headline"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_pruning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/plant_info_card_shape"
                android:gravity="center"
                android:layout_marginStart="@dimen/_4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_pruning" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/pruning"
                    android:textColor="@color/text_headline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pruning_months_text_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Unknown"
                    android:gravity="center_vertical"
                    android:lines="2"
                    android:textColor="@color/text_main_color"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_8dp">

            <LinearLayout
                android:id="@+id/card_sunlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/plant_info_card_shape"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/_4dp"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_sunlight" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/sunlight"
                    android:textColor="@color/text_headline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sunlight_types_text_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Unknown"
                    android:gravity="center_vertical"
                    android:lines="2"
                    android:textColor="@color/text_main_color"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_soil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/plant_info_card_shape"
                android:layout_marginStart="@dimen/_4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_soil" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="@string/soil_planted"
                    android:textColor="@color/text_headline"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/soil_text_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Unknown"
                    android:lines="2"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_main_color"
                    android:textSize="@dimen/_12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/watering_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:background="@drawable/plant_info_card_shape"
        android:orientation="vertical"
        android:padding="@dimen/_12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.expeditee.plant.identifier.utils.ReadMoreTextView
            android:id="@+id/watering_guide_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            app:trimLines="2"
            tools:text="@tools:sample/lorem/random" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pruning_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:background="@drawable/plant_info_card_shape"
        android:orientation="vertical"
        android:padding="@dimen/_12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.expeditee.plant.identifier.utils.ReadMoreTextView
            android:id="@+id/pruning_guide_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            app:trimLines="2"
            tools:text="@tools:sample/lorem/random" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sunlight_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:background="@drawable/plant_info_card_shape"
        android:orientation="vertical"
        android:padding="@dimen/_12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.expeditee.plant.identifier.utils.ReadMoreTextView
            android:id="@+id/sunlight_guide_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/_2dp"
            android:textColor="@color/text_headline"
            android:textSize="@dimen/_14sp"
            app:trimLines="2"
            tools:text="@tools:sample/lorem/random" />
    </LinearLayout>

</LinearLayout>
