<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4dp">

        <LinearLayout
            android:id="@+id/llChatMessageUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_60dp"
            android:layout_marginEnd="@dimen/_16dp"
            android:layout_marginVertical="@dimen/_6dp"
            android:gravity="end"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end"
                android:maxWidth="280dp"
                android:orientation="vertical">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="200dp"
                    android:layout_height="150dp"
                    android:layout_marginBottom="@dimen/_8dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:riv_corner_radius="@dimen/_8dp"
                    tools:src="@tools:sample/avatars"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_message"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat_regular"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="@dimen/_16dp"
                    android:paddingVertical="@dimen/_12dp"
                    android:textColor="@color/text_color_main"
                    android:textSize="@dimen/_14sp"
                    tools:text="Your message here" />

            </LinearLayout>

        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieTyping"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_36dp"
            android:layout_marginStart="@dimen/_18dp"
            android:layout_marginTop="@dimen/_8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llChatMessageUser"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_typing" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>