<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FDFDFD">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPremium"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/img_header_premium"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/frClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginTop="@dimen/_40dp"
                android:elevation="@dimen/_4dp"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close_iap" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12dp"
                android:elevation="@dimen/_4dp"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.expeditee.plant.identifier.widget.StrokeTextView
                android:id="@+id/tvPremium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_marginBottom="@dimen/_20dp"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeMinTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/notosans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/get_premium"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                app:fillColor="@android:color/white"
                app:shadowColor="#8A49AF2E"
                app:shadowRadius="7dp"
                app:strokeEndColor="#FFFFFF"
                app:strokeStartColor="#3D940E"
                app:strokeWidth="3.6dp" />

            <LinearLayout
                android:id="@+id/llFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="@dimen/_40dp"
                android:gravity="center"

                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        android:clickable="false"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:src="@drawable/ic_scan_iap" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="start|top"
                        android:maxLines="1"
                        android:text="@string/unlimited_plant_identification"
                        android:textColor="@color/text_headline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        android:clickable="false"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:src="@drawable/ic_care_iap" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="start|top"
                        android:maxLines="1"
                        android:text="@string/care_schedule_reminders"
                        android:textColor="@color/text_headline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        android:clickable="false"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:src="@drawable/ic_offline_mode" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="start|top"
                        android:maxLines="1"
                        android:text="@string/offline_plant_identification"
                        android:textColor="@color/text_headline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        android:clickable="false"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:src="@drawable/ic_ai_24_7" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="start|top"
                        android:maxLines="1"
                        android:text="@string/_24_7_ai_plant_support"
                        android:textColor="@color/text_headline" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cstFreeTrialToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_18dp"
                android:layout_marginTop="@dimen/_20dp"
                android:background="@drawable/bg_trial_sub"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_16dp"
                android:paddingVertical="@dimen/_10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFreeTrialLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter"
                        android:text="@string/free_trial_enabled"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="@string/auto_renewable_cancel_anytime"
                        android:textColor="#999999"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/switchFreeTrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_legacy_iap_uncheck" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cstWeeklyPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_18dp"
                android:layout_marginTop="@dimen/_16dp"
                android:background="@drawable/bg_sub_selector"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_16dp"
                android:paddingVertical="@dimen/_16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWeeklyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="@string/lb_weekly_plan"
                        android:textColor="@color/text_plan_selector"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2dp"
                        android:clickable="false"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:fontFamily="@font/montserrat_medium"
                        android:maxLines="1"
                        android:text="@string/weekly_subtitle"
                        android:textColor="#999999"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPricePerWeekly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="@font/montserrat_semibold"
                        android:textColor="@color/text_plan_selector"
                        android:textSize="15sp"
                        tools:text="$6.99" />

                    <TextView
                        android:id="@+id/tvPerWeek2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="@string/per_week"
                        android:textColor="@color/primary_green"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_18dp"
                android:layout_marginTop="@dimen/_6dp">

                <LinearLayout
                    android:id="@+id/cstYearlyPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:background="@drawable/bg_sub_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_16dp"
                    android:paddingVertical="@dimen/_16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvYearlyTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:fontFamily="@font/inter"
                            android:maxLines="1"
                            android:text="@string/lb_yearly_plan"
                            android:textColor="@color/text_plan_selector"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvYearlySubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2dp"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:fontFamily="@font/montserrat_medium"
                            android:maxLines="1"
                            android:text="@string/yearly_subtitle"
                            android:textColor="#999999"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPricePerYearly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/montserrat_semibold"
                            android:textColor="@color/text_plan_selector"
                            android:textSize="15sp"
                            tools:text="$0.77" />

                        <TextView
                            android:id="@+id/tvPerWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="@string/per_week"
                            android:textColor="@color/primary_green"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPlanOffer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/_30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_iap_best_value" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSubscribe"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60dp"
                android:layout_marginHorizontal="@dimen/_18dp"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_btn_continue">

                <TextView
                    android:id="@+id/tvSubscribe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="32dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:gravity="center"
                    android:text="@string/start_free_trial"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="@string/start_free_trial" />

                <View
                    android:id="@+id/viewShine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shine" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_regular"
                        android:paddingVertical="@dimen/_4dp"
                        android:text="@string/terms_of_use"
                        android:textColor="@color/gray_iap"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/tvPrivacy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="end"
                        android:paddingVertical="@dimen/_4dp"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/gray_iap"
                        android:textSize="@dimen/_12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSubscribeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:lines="4"
                    android:textColor="@color/gray_iap"
                    android:textSize="12sp"
                    tools:text="@tools:sample/lorem/random" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
