<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result_dialog_card"
            android:orientation="vertical"
            android:padding="@dimen/_20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="center"
                android:text="Thêm mốc nhật ký"
                android:textColor="@color/result_text_primary"
                android:textSize="@dimen/_18sp" />

            <TextView
                android:id="@+id/tvEventTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Tiêu đề mốc"
                android:textColor="@color/result_text_primary"
                android:textSize="@dimen/_14sp" />

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/_6dp"
                android:background="@drawable/bg_result_input"
                android:fontFamily="@font/montserrat_regular"
                android:hint="Ra lá mới"
                android:inputType="textCapSentences"
                android:paddingHorizontal="@dimen/_14dp"
                android:textColor="@color/result_text_primary"
                android:textColorHint="@color/result_text_muted"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/tvEventContentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Nội dung / quan sát"
                android:textColor="@color/result_text_primary"
                android:textSize="@dimen/_14sp" />

            <EditText
                android:id="@+id/etEventContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                android:background="@drawable/bg_result_input"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="top"
                android:hint="Cây cao thêm, tưới 1 lần/ngày…"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="88dp"
                android:paddingHorizontal="@dimen/_14dp"
                android:paddingVertical="@dimen/_10dp"
                android:textColor="@color/result_text_primary"
                android:textColorHint="@color/result_text_muted"
                android:textSize="@dimen/_14sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/_12dp"
                android:background="@drawable/bg_round_8_gray"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnPickPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:background="@drawable/bg_more_option_white"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Chọn ảnh cho mốc này"
                android:textColor="@color/result_green" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_more_option_white"
                    android:fontFamily="@font/montserrat_semibold"
                    android:gravity="center"
                    android:text="Huỷ"
                    android:textColor="@color/result_green" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_more_option_green"
                    android:fontFamily="@font/montserrat_semibold"
                    android:gravity="center"
                    android:text="Lưu"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
