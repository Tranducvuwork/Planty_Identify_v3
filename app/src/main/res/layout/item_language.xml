<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="isSelected"
            type="Boolean" />

        <variable
            name="nameLanguage"
            type="String" />

        <variable
            name="onItemClicked"
            type="View.OnClickListener" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/bg_item_language_selector"
        android:elevation="6dp"
        android:minHeight="56dp"
        android:onClick="@{onItemClicked}"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivLanguage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_vietnamese" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:clickable="false"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{nameLanguage}"
            android:textColor="#020617"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLanguage"
            app:layout_constraintEnd_toStartOf="@id/ivChecked"
            app:layout_constraintStart_toEndOf="@id/ivLanguage"
            app:layout_constraintTop_toTopOf="@id/ivLanguage"
            tools:text="Vietnamese" />

        <ImageView
            android:id="@+id/ivChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:src="@{(isSelected ?? false) ? @drawable/ic_language_checked : @drawable/ic_language_unchecked}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_language_unchecked" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
