<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#26000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1px"
                android:color="#E0E0E0" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>